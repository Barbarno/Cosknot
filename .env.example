# Plantilla de variables de entorno. En local se copia a `.env` y Flask la carga con
# python-dotenv. En Heroku no se sube: se configuran con `heroku config:set`.
# Ningún secreto vive en el repositorio.

# --- base y sesión ---
# Cadena de conexión. Vacío = SQLite (cosknot.db) en local.
# En Heroku la pone el addon: `heroku config:get DATABASE_URL`.
# Acepta postgres:// y postgresql://; se normaliza a postgresql+psycopg://.
DATABASE_URL=

# Clave para firmar las sesiones de Flask. Genera una con:
# python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Entorno. En Heroku: production. En local déjalo vacío o development.
# Si falta, se considera producción cuando existe DYNO (lo pone Heroku).
APP_ENV=development

# Siembra el catálogo de ejemplo al arrancar. En SQLite (local) se siembra solo;
# en PostgreSQL solo si esto vale 1 o si se lanza `flask sembrar`.
SEED_ON_START=

# --- proxy (router de Heroku) ---
# Saltos de proxy en los que confiar. El router de Heroku añade uno a
# X-Forwarded-For y otro a X-Forwarded-Proto; con Cloudflare en modo DNS only
# (nube gris) 1 es exacto. Se acota entre 0 y 5.
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1

# --- pool de conexiones ---
# techo: pool_size + max_overflow = 5 conexiones de la app, 8 de 20 en total.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=10

# --- límite de peticiones ---
# memory:// = contador en el proceso. Exacto con un solo worker (Procfile).
# Se pierde al reiniciar el dyno; ver docs/decisions/0003.
RATELIMIT_STORAGE_URI=memory://

# --- imágenes (fase 4) ---
# Backend de subidas: `local` (static/uploads, solo desarrollo) o `r2`.
# Vacío = local en desarrollo y subidas desactivadas en producción.
IMAGE_STORAGE=
# Directorio del backend local. Relativo a la raíz del proyecto.
UPLOAD_DIR=static/uploads

# Cloudflare R2 (API compatible con S3). Las cinco son obligatorias si IMAGE_STORAGE=r2.
# endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Dominio público del bucket. Se abre en img-src de la CSP, sin comodines.
R2_PUBLIC_BASE_URL=

# --- correo (fase 3) ---
# Resend por HTTP (Heroku bloquea SMTP). Sin RESEND_API_KEY el correo se imprime
# en consola en desarrollo y queda desactivado en producción.
RESEND_API_KEY=
# Remitente verificado en Resend, por ejemplo: cosknot <hola@tudominio.com>
EMAIL_FROM=
# Responder-a opcional para los avisos.
EMAIL_REPLY_TO=
# 1 (defecto) = intentar en la petición y, si falla, dejar el aviso en
# email_outbox para que el hilo de reintentos lo recoja. 0 = solo en la petición.
EMAIL_ASYNC=1
# Reintentos máximos por aviso antes de dejarlo como `fallido`.
EMAIL_MAX_INTENTOS=5

# --- sugerencias con IA (fase 4, opcional) ---
# Sin clave, el botón de sugerencias no aparece. Modelo obligatorio si hay clave:
# no se inventa un valor por defecto en el código.
GEMINI_API_KEY=
GEMINI_MODEL=
# Tiempo máximo de espera de la sugerencia, en segundos.
GEMINI_TIMEOUT=20

# --- pagos (fase 6) ---
# Stripe Connect en modo test. Una clave sk_live_ se rechaza a propósito.
# Sin las tres variables de abajo el cobro queda desactivado y la web lo dice.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secreto del endpoint /stripe/webhook (whsec_...). Obligatorio para cobrar.
STRIPE_WEBHOOK_SECRET=
# Comisión de cosknot en porcentaje. Sin valor por defecto: si falta, no se cobra.
COMMISSION_PERCENT=

# --- errores y registro (fase 8) ---
# Nivel de logging: DEBUG, INFO, WARNING, ERROR. Por defecto INFO.
LOG_LEVEL=INFO
# Sentry solo se inicializa si hay DSN. Vacío = desactivado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Muestreo de trazas de 0 a 1. Por defecto 0 (solo errores).
SENTRY_TRACES_SAMPLE_RATE=0
