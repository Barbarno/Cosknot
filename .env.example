# Cadena de conexión de Neon. En el panel de Neon: Connect -> copia la que lleva `-pooler`.
# En local, vacío: la app usa SQLite (cosknot.db).
DATABASE_URL=

# Clave para firmar las sesiones de Flask. Genera una con:
# python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Entorno local. En Render se pone production.
FLASK_ENV=development

# Siembra el catálogo de ejemplo al arrancar. En SQLite (local) se siembra solo;
# en PostgreSQL solo si esto vale 1 o si se lanza `flask sembrar`.
SEED_ON_START=
