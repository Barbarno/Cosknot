# Cadena de conexiÃ³n de Neon. En el panel de Neon: Connect -> copia la que lleva `-pooler`.
# En local, vacÃ­o: la app usa SQLite (cosknot.db).
DATABASE_URL=

# Clave para firmar las sesiones de Flask. Genera una con:
# python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Entorno local. En Render se pone production.
FLASK_ENV=development

# Siembra el catÃ¡logo de ejemplo al arrancar. En SQLite (local) se siembra solo;
# en PostgreSQL solo si esto vale 1 o si se lanza `flask sembrar`.
SEED_ON_START=

# --- imágenes (fase 4) ---
# Backend de subidas: `local` (static/uploads, solo desarrollo) o `r2`.
# Vacío = local en desarrollo y subidas desactivadas en producción.
IMAGE_STORAGE=
# Directorio del backend local. Relativo a la raíz del proyecto.
UPLOAD_DIR=static/uploads

# Cloudflare R2 (API compatible con S3). Las cinco son obligatorias si IMAGE_STORAGE=r2.
# endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Dominio público del bucket. Se abre en img-src de la CSP, sin comodines.
R2_PUBLIC_BASE_URL=

# --- correo (fase 5) ---
# Resend por HTTP (Render free bloquea SMTP). Sin RESEND_API_KEY el correo se
# imprime en consola en desarrollo y queda desactivado en producción.
RESEND_API_KEY=
# Remitente verificado en Resend, por ejemplo: cosknot <hola@tudominio.com>
EMAIL_FROM=
# Responder-a opcional para los avisos.
EMAIL_REPLY_TO=
# 0 = enviar dentro de la petición (útil para depurar). Por defecto 1: en un hilo.
EMAIL_ASYNC=1
