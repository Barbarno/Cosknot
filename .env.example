# Variables de entorno previstas. Copia este fichero a .env y rellena los valores.
# Ningún valor real va al repositorio.

# --- aplicación ---
SECRET_KEY=
DATABASE_URL=sqlite:///cosknot.db
APP_ENV=development

# --- cobros (Stripe, modo prueba) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
COMMISSION_PERCENT=8

# --- fotos (Cloudflare R2) ---
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# --- correo (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- IA (Gemini, opcional) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- errores (Sentry, opcional) ---
SENTRY_DSN=
